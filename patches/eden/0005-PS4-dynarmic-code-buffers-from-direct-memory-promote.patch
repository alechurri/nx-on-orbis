Date: Sat, 3 Oct 2026 22:26:23 -0300
Subject: [PATCH 05/31] PS4: dynarmic code buffers from direct memory promoted
 to RWX

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dynarmic/backend/x64/block_of_code.cpp    | 77 +++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp b/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
index 384d620..f006130 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
@@ -23,6 +23,10 @@
 
 #include <array>
 #include <cstring>
+#include <vector>
+#ifdef __ORBIS__
+#include <sys/types.h>
+#endif
 
 #include "common/assert.h"
 #include "dynarmic/mcl/bit.hpp"
@@ -140,6 +144,75 @@ bool IsUnderRosetta() {
 }
 #endif
 
+#ifdef __ORBIS__
+// PS4: code buffers come from direct memory, mapped read-write and then promoted to RWX with
+// sceKernelMprotect - the only order the kernel grants (an anonymous mmap is flexible memory, a
+// small pool that is not known to take PROT_EXEC). Measured on the target console (eden-probe
+// JIT/JITBIG): 16-512 MiB buffers mapped this way run generated code. They stay RWX, so the build
+// has DYNARMIC_ENABLE_NO_EXECUTE_SUPPORT off.
+}  // anonymous namespace
+}  // namespace Dynarmic::Backend::X64
+
+extern "C" {
+int32_t sceKernelAllocateDirectMemory(off_t, off_t, size_t, size_t, int32_t, off_t*);
+int32_t sceKernelMapDirectMemory(void**, size_t, int32_t, int32_t, off_t, size_t);
+int32_t sceKernelMprotect(const void*, size_t, int);
+int32_t sceKernelReleaseDirectMemory(off_t, size_t);
+int32_t sceKernelMunmap(void*, size_t);
+size_t sceKernelGetDirectMemorySize(void);
+}
+
+namespace Dynarmic::Backend::X64 {
+namespace {
+struct OrbisCodeAllocator final : Xbyak::Allocator {
+    static constexpr size_t Granule = 0x4000;
+    struct Block {
+        uint8_t* addr;
+        size_t size;
+        off_t phys;
+    };
+    std::vector<Block> blocks;
+
+    uint8_t* alloc(size_t size) override {
+        size = (size + Granule - 1) & ~(Granule - 1);
+        off_t phys = 0;
+        if (sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), size, Granule, 0 /*WB_ONION*/, &phys) != 0) {
+            return nullptr;
+        }
+        void* addr = nullptr;
+        if (sceKernelMapDirectMemory(&addr, size, 0x03 /*CPU RW*/, 0, phys, Granule) != 0) {
+            sceKernelReleaseDirectMemory(phys, size);
+            return nullptr;
+        }
+        if (sceKernelMprotect(addr, size, 0x07 /*CPU RWX*/) != 0) {
+            sceKernelMunmap(addr, size);
+            sceKernelReleaseDirectMemory(phys, size);
+            return nullptr;
+        }
+        blocks.push_back({static_cast<uint8_t*>(addr), size, phys});
+        return static_cast<uint8_t*>(addr);
+    }
+    void free(uint8_t* p) override {
+        for (size_t i = 0; i < blocks.size(); ++i) {
+            if (blocks[i].addr == p) {
+                sceKernelMunmap(p, blocks[i].size);
+                sceKernelReleaseDirectMemory(blocks[i].phys, blocks[i].size);
+                blocks.erase(blocks.begin() + std::ptrdiff_t(i));
+                return;
+            }
+        }
+    }
+    bool useProtect() const override {
+        return false; // already RWX
+    }
+};
+
+Xbyak::Allocator* CodeAllocator() {
+    static OrbisCodeAllocator allocator;
+    return &allocator;
+}
+#endif
+
 }  // anonymous namespace
 
 BlockOfCode::BlockOfCode(RunCodeCallbacks cb, JitStateInfo jsi, size_t total_code_size, std::function<void(BlockOfCode&)> rcp)
@@ -149,7 +222,11 @@ BlockOfCode::BlockOfCode(RunCodeCallbacks cb, JitStateInfo jsi, size_t total_cod
 #else
         , nullptr //Allow RWE
 #endif
+#ifdef __ORBIS__
+        , CodeAllocator())
+#else
         , nullptr)
+#endif
     , constant_pool(*this, CONSTANT_POOL_SIZE)
     , jsi(jsi)
     , cb(std::move(cb))
