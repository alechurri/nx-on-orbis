From 53e5cd4be3ea81b40d096746bd2f1b3da47c0cd4 Mon Sep 17 00:00:00 2001
From: alechurri <337117637+alechurri@users.noreply.github.com>
Date: Tue, 6 Oct 2026 16:57:48 -0300
Subject: [PATCH 23/31] PS4: read each GPU page-table entry back right after
 registering it

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/texture_cache/texture_cache.h | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index 7aef648..20cee6a 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -2316,6 +2316,23 @@ void TextureCache<P>::RegisterImage(ImageId image_id) {
         gpu_page_table_storage[slot_images[image_id].registered_gpu_map * 2][page].push_back(image_id);
         Ps4History::Record("gpu_page+", image_id.index, page << YUZU_PAGEBITS,
                            slot_images[image_id].registered_gpu_map, 0, 0, frame_tick);
+        {
+            // Read it straight back: is the entry lost at once (the container) or later?
+            auto& table = gpu_page_table_storage[slot_images[image_id].registered_gpu_map * 2];
+            const auto found = table.find(page);
+            if (found == table.end() ||
+                std::ranges::find(found->second, image_id) == found->second.end()) {
+                static u32 immediate_misses = 0;
+                if (immediate_misses++ < 8) {
+                    LOG_WARNING(Render_Vulkan,
+                                "PS4 page table: id={} pushed into GPU page {:#x} and not found "
+                                "right after ({}; table size {})",
+                                image_id.index, page << YUZU_PAGEBITS,
+                                found == table.end() ? "no page" : "page without the id",
+                                table.size());
+                }
+            }
+        }
 #else
         (*channel_state->gpu_page_table)[page].push_back(image_id);
 #endif
-- 
