+#include <pthread.h>
+namespace VideoCommon::Ps4History {
+// Last texture-cache events per image (register / unregister / delete), with thread and caller,
+// dumped for an image the first times it is found inconsistent. Under the cache mutex.
+struct Event {
+    const char* op;
+    u32 id;
+    u64 gpu;
+    u64 cpu;
+    u64 size;
+    u64 thread;
+    u64 caller;
+    u64 tick;
+};
+inline Event ring[4096];
+inline u32 next = 0;
+inline u32 dumps = 0;
+inline void Record(const char* op, u32 id, u64 gpu, u64 cpu, u64 size, u64 caller, u64 tick) {
+    ring[next++ % 4096] = {op, id, gpu, cpu, size, u64(pthread_self()), caller, tick};
+}
+template <typename LogFn>
+inline void Dump(u32 id, LogFn&& log) {
+    if (dumps >= 6) {
+        return;
+    }
+    ++dumps;
+    const u32 count = next < 4096 ? next : 4096;
+    for (u32 i = 0; i < count; ++i) {
+        const Event& e = ring[(next - count + i) % 4096];
+        if (e.op != nullptr && e.id == id) {
+            log(e);
+        }
+    }
+}
+} // namespace VideoCommon::Ps4History
 #endif
 
 namespace VideoCommon {
