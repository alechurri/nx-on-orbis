From 6dbb8470a1f61d4a4c8ec9c20ec71bdd5c43f113 Mon Sep 17 00:00:00 2001
From: alechurri <337117637+alechurri@users.noreply.github.com>
Date: Sun, 4 Oct 2026 01:58:42 -0300
Subject: [PATCH 09/31] PS4: avoid RADV GFX7 GPU hangs from indirect-count
 draws and conditional rendering

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/macro.cpp                       | 5 +++++
 src/video_core/vulkan_common/vulkan_device.cpp | 7 +++++++
 2 files changed, 12 insertions(+)

diff --git a/src/video_core/macro.cpp b/src/video_core/macro.cpp
index 86f528a..652ded0 100644
--- a/src/video_core/macro.cpp
+++ b/src/video_core/macro.cpp
@@ -198,7 +198,12 @@ void HLE_MultiLayerClear::Execute(Core::System& system, Engines::Maxwell3D& maxw
 }
 void HLE_MultiDrawIndexedIndirectCount::Execute(Core::System& system, Engines::Maxwell3D& maxwell3d, std::span<const u32> parameters, [[maybe_unused]] u32 method) {
     const auto topology = Maxwell3D::Regs::PrimitiveTopology(parameters[2]);
+#ifdef __ORBIS__
+    // PS4 RADV hangs on indirect draws with a count buffer: issue the draws one by one.
+    if (false) {
+#else
     if (IsTopologySafe(topology)) {
+#endif
         const u32 start_indirect = parameters[0];
         const u32 end_indirect = parameters[1];
         if (start_indirect >= end_indirect) {
diff --git a/src/video_core/vulkan_common/vulkan_device.cpp b/src/video_core/vulkan_common/vulkan_device.cpp
index be09bca..e3088b6 100644
--- a/src/video_core/vulkan_common/vulkan_device.cpp
+++ b/src/video_core/vulkan_common/vulkan_device.cpp
@@ -732,6 +732,13 @@ Device::Device(VkInstance instance_, vk::PhysicalDevice physical_, VkSurfaceKHR
                                VK_KHR_BUFFER_DEVICE_ADDRESS_EXTENSION_NAME);
     }
 
+#ifdef __ORBIS__
+    // PS4 RADV (GFX7 "Liverpool"): an indirect draw with a count buffer hangs the GPU, and
+    // predication has hung this command processor too. Both end in VK_ERROR_DEVICE_LOST.
+    RemoveExtension(extensions.conditional_rendering, VK_EXT_CONDITIONAL_RENDERING_EXTENSION_NAME);
+    RemoveExtension(extensions.draw_indirect_count, VK_KHR_DRAW_INDIRECT_COUNT_EXTENSION_NAME);
+#endif
+
     logical = vk::Device::Create(physical, queue_cis, ExtensionListForVulkan(loaded_extensions), first_next, dld);
 
     graphics_queue = logical.GetQueue(graphics_family);
-- 
