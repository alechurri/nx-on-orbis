         image.map_view_id = map_id;
         return;
     }
@@ -2349,6 +2423,9 @@ void TextureCache<P>::UnregisterImage(ImageId image_id) {
                 return;
             }
             image_ids.erase(vector_it);
+#ifdef __ORBIS__
+            Ps4History::Record("gpu_page-", image_id.index, page << YUZU_PAGEBITS, 0, 0, 0, 0);
+#endif
         };
     ForEachGPUPage(image.gpu_addr, image.guest_size_bytes, [this, image_id, &clear_page_table](u64 page) {
 #ifdef __ORBIS__
@@ -2377,6 +2454,10 @@ void TextureCache<P>::UnregisterImage(ImageId image_id) {
                 return;
             }
             image_map_ids.erase(vector_it);
+#ifdef __ORBIS__
+            Ps4History::Record("cpu_page-", slot_map_views[map_id].image_id.index,
+                               page << YUZU_PAGEBITS, map_id.index, 0, 0, 0);
