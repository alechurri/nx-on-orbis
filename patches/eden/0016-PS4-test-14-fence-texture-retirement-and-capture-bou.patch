+#ifdef __ORBIS__
+// Capture the first effective decoded output, in linear order before guest swizzling.
+// Strip padding and cap the dump at 8 MiB; never make a GPU pipeline for diagnosis.
+void Ps4DumpVicFrame(std::span<const u8> luma, std::span<const u8> chroma,
+                    u32 width, u32 height, u32 bytes_per_pixel, u32 luma_stride,
+                    u32 chroma_row_bytes, u32 chroma_height, u32 chroma_stride, u32 format) {
+    static std::atomic_bool attempted{false};
+    if (attempted.load(std::memory_order_relaxed)) {
+        return;
+    }
+    constexpr size_t MaxBytes = 8 * 1024 * 1024;
+    const size_t row_bytes = size_t(width) * bytes_per_pixel;
+    const size_t luma_bytes = row_bytes * height;
+    const size_t chroma_bytes = size_t(chroma_row_bytes) * chroma_height;
+    if (luma.data() == nullptr || width == 0 || height == 0 || width > 4096 || height > 4096 ||
+        (bytes_per_pixel != 1 && bytes_per_pixel != 4) ||
+        (chroma_bytes != 0 && chroma.data() == nullptr) ||
+        row_bytes > luma_stride || size_t(luma_stride) * height > luma.size() ||
+        chroma_row_bytes > chroma_stride ||
+        size_t(chroma_stride) * chroma_height > chroma.size() ||
+        luma_bytes > MaxBytes || chroma_bytes > MaxBytes - luma_bytes) {
+        static std::atomic_uint invalid_logs{0};
+        if (invalid_logs.fetch_add(1, std::memory_order_relaxed) < 4) {
+            LOG_WARNING(HW_GPU, "PS4 VIC dump skipped: invalid/oversized {}x{} format {}", width,
+                        height, format);
+        }
+        return;
+    }
+    if (attempted.exchange(true, std::memory_order_relaxed)) {
+        return;
+    }
+    auto* raw = std::fopen("/data/edenps4/vic_frame.raw", "wb");
+    bool ok = raw != nullptr;
+    if (raw) {
+        auto write_rows = [raw](std::span<const u8> plane, size_t stride, size_t bytes,
+                               u32 rows) {
+            for (u32 y = 0; y < rows; ++y) {
+                if (std::fwrite(plane.data() + size_t(y) * stride, 1, bytes, raw) != bytes) {
+                    return false;
+                }
+            }
+            return true;
+        };
+        ok = write_rows(luma, luma_stride, row_bytes, height);
+        if (ok && chroma_bytes != 0) {
+            ok = write_rows(chroma, chroma_stride, chroma_row_bytes, chroma_height);
+        }
+        ok = std::fclose(raw) == 0 && ok;
+    }
+    auto* meta = std::fopen("/data/edenps4/vic_frame.txt", "w");
+    bool meta_ok = meta != nullptr;
+    if (meta) {
+        meta_ok = std::fprintf(meta,
+            "test14 effective VIC output; raw_complete %u\n"
+            "width %u height %u format %u bytes_per_pixel %u\n"
+            "luma_source_stride %u raw_row_bytes %zu raw_luma_bytes %zu\n"
+            "chroma_source_stride %u raw_row_bytes %u rows %u raw_chroma_bytes %zu\n"
+            "raw layout: tightly packed luma/RGB, then interleaved U,V chroma (if present); no padding\n"
+            "RGB formats: 31=A8B8G8R8 (R,G,B,A bytes), 32=A8R8G8B8 (B,G,R,A bytes), 35=X8B8G8R8\n",
+            unsigned(ok), width, height, format, bytes_per_pixel, luma_stride, row_bytes,
+            luma_bytes, chroma_stride, chroma_row_bytes, chroma_height, chroma_bytes) >= 0;
+        meta_ok = std::fclose(meta) == 0 && meta_ok;
+    }
+    LOG_WARNING(HW_GPU, "PS4 VIC dump: raw_complete={} metadata_complete={} {}x{} format {} bytes {}",
+                ok, meta_ok, width, height, format, luma_bytes + chroma_bytes);
+}
+#endif
