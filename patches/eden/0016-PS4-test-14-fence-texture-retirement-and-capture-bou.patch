@@ -17,6 +17,15 @@ namespace VideoCommon {
 template <typename T, size_t TICKS_TO_DESTROY>
 class DelayedDestructionRing {
 public:
+    /// Objects that the next Tick would destroy; callers can synchronize before retiring them.
+    [[nodiscard]] size_t PendingDestructionCount() const {
+        return elements[(index + 1) % TICKS_TO_DESTROY].size();
+    }
+
+    [[nodiscard]] bool HasPendingDestruction() const {
+        return PendingDestructionCount() != 0;
+    }
+
     void Tick() {
         index = (index + 1) % TICKS_TO_DESTROY;
         elements[index].clear();
