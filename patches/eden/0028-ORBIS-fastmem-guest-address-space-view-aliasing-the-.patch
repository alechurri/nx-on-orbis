+// ---- fastmem view ---------------------------------------------------------------------------
+// One entry per 16 KiB view page, in second-level tables of one GiB each (allocated when a guest
+// mapping first lands there). Entry layout:
+//   bits  0..31  backing page (offset into the guest RAM backing / 16 KiB)
+//   bits 32..35  4 KiB guest page mapped here (by ViewMap, cleared by ViewUnmap)
+//   bits 36..39  ... readable
+//   bits 40..43  ... writable
+//   bits 48..49  what the host has: 0 nothing (reserved), 1 mapped read-only, 2 read-write
+// All of it under g_lock, like the chunk tables.
+constexpr std::size_t ViewPage = 16 * 1024;
+constexpr std::size_t SubPage = 4 * 1024;
+constexpr std::size_t ViewSpanBits = 30;
+constexpr std::size_t PagesPerSpan = (std::size_t{1} << ViewSpanBits) / ViewPage;
+constexpr std::uint64_t ValidShift = 32, ReadShift = 36, WriteShift = 40, HostShift = 48;
+constexpr int ProtRead = 0x01, ProtReadWrite = 0x03;
+
+std::atomic<bool> g_fastmem_ok{false};
+std::uintptr_t g_view_base = 0;
+std::size_t g_view_size = 0;
+std::uint64_t** g_view_tables = nullptr; // g_view_size >> 30 pointers
+std::atomic<JitFaultHandler> g_jit{nullptr};
+std::atomic<std::size_t> g_view_mapped{0};
+std::atomic<std::size_t> g_view_touches{0};
+std::atomic<std::size_t> g_jit_redirects{0};
+std::atomic<std::size_t> g_view_conflicts{0};
+
+std::uint64_t* ViewEntryLocked(std::size_t page, bool create) {
+    const std::size_t span = page / PagesPerSpan;
+    if (span >= (g_view_size >> ViewSpanBits)) {
+        return nullptr;
+    }
+    std::uint64_t*& table = g_view_tables[span];
+    if (table == nullptr) {
+        if (!create) {
+            return nullptr;
+        }
+        table = new (std::nothrow) std::uint64_t[PagesPerSpan]();
+        if (table == nullptr) {
+            return nullptr;
+        }
+    }
+    return &table[page % PagesPerSpan];
+}
+
+int WantedHost(std::uint64_t e) {
+    const unsigned valid = (e >> ValidShift) & 0xF;
+    const unsigned read = (e >> ReadShift) & 0xF;
+    const unsigned write = (e >> WriteShift) & 0xF;
+    if (valid != 0xF || read != 0xF) {
+        return 0;
+    }
+    return write == 0xF ? 2 : 1;
+}
+
+void ReserveViewPage(std::uintptr_t addr) {
+    void* at = reinterpret_cast<void*>(addr);
+    if (sceKernelReserveVirtualRange(&at, ViewPage, MapFixed, ViewPage) != 0) {
+        at = reinterpret_cast<void*>(addr);
+        sceKernelMunmap(at, ViewPage);
+        sceKernelReserveVirtualRange(&at, ViewPage, MapFixed, ViewPage); // best effort
+    }
+}
+
+void DropHostLocked(std::size_t page, std::uint64_t& e) {
+    if (((e >> HostShift) & 3) != 0) {
+        ReserveViewPage(g_view_base + page * ViewPage);
+        e &= ~(std::uint64_t{3} << HostShift);
+        g_view_mapped.fetch_sub(1, std::memory_order_relaxed);
+    }
+}
+
+/// Brings the host mapping of one view page in line with its entry. Mapping itself waits for the
+/// first touch; this only takes access away (or changes it on a page already mapped).
+void ApplyLocked(std::size_t page, std::uint64_t& e) {
+    const int have = static_cast<int>((e >> HostShift) & 3);
+    const int want = WantedHost(e);
+    if (have == want || have == 0) {
+        return;
+    }
+    if (want == 0) {
+        DropHostLocked(page, e);
+        return;
+    }
+    const std::uintptr_t addr = g_view_base + page * ViewPage;
+    if (sceKernelMprotect(reinterpret_cast<void*>(addr), ViewPage,
+                          want == 2 ? ProtReadWrite : ProtRead) != 0) {
+        DropHostLocked(page, e); // the next touch maps it again with the right access
+        return;
+    }
+    e = (e & ~(std::uint64_t{3} << HostShift)) | (std::uint64_t(want) << HostShift);
+}
+
+Region* GuestRegion() {
+    return FindRegion(reinterpret_cast<std::uintptr_t>(g_guest_base.load(std::memory_order_relaxed)));
+}
+
+/// A first touch of a view page that should be mapped: map its backing there. False when the
+/// fault is not ours to fix (unmapped or protected on purpose: dynarmic's).
+bool ViewFault(std::uintptr_t addr) {
+    if (g_view_base == 0 || addr < g_view_base || addr - g_view_base >= g_view_size) {
+        return false;
+    }
+    SpinGuard guard;
+    const std::size_t page = (addr - g_view_base) / ViewPage;
+    std::uint64_t* e = ViewEntryLocked(page, false);
+    if (e == nullptr) {
+        return false;
+    }
+    const int want = WantedHost(*e);
+    if (want == 0 || ((*e >> HostShift) & 3) != 0) {
+        return false;
+    }
+    Region* r = GuestRegion();
+    const std::size_t backing = static_cast<std::size_t>(*e & 0xFFFFFFFFu) * ViewPage;
+    if (r == nullptr || backing >= r->size) {
+        return false;
+    }
+    const std::size_t chunk = backing / Chunk;
+    if (!CommitChunkLocked(*r, chunk)) {
+        return false;
+    }
+    const off_t phys = r->phys[chunk].load(std::memory_order_relaxed) +
+                       static_cast<off_t>(backing % Chunk);
+    void* at = reinterpret_cast<void*>(g_view_base + page * ViewPage);
+    if (sceKernelMapDirectMemory(&at, ViewPage, want == 2 ? ProtReadWrite : ProtRead, MapFixed,
+                                 phys, ViewPage) != 0 ||
+        reinterpret_cast<std::uintptr_t>(at) != g_view_base + page * ViewPage) {
+        return false;
+    }
+    *e = (*e & ~(std::uint64_t{3} << HostShift)) | (std::uint64_t(want) << HostShift);
+    g_view_mapped.fetch_add(1, std::memory_order_relaxed);
+    g_view_touches.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+/// For each 4 KiB guest page of [view_offset, view_offset + size): fn(entry, subpage, address).
+/// Each entry touched is re-applied afterwards.
+template <typename Fn>
+void ForEachSubPage(std::size_t view_offset, std::size_t size, bool create, Fn&& fn) {
+    if (g_view_base == 0 || size == 0 || view_offset >= g_view_size) {
+        return;
+    }
+    if (size > g_view_size - view_offset) {
+        size = g_view_size - view_offset;
+    }
+    const std::size_t first = view_offset & ~(SubPage - 1);
+    const std::size_t end = view_offset + size;
+    SpinGuard guard;
+    std::size_t page = ~std::size_t{0};
+    std::uint64_t* e = nullptr;
+    for (std::size_t a = first; a < end; a += SubPage) {
+        const std::size_t p = a / ViewPage;
+        if (p != page) {
+            if (e != nullptr) {
+                ApplyLocked(page, *e);
+            }
+            page = p;
+            e = ViewEntryLocked(p, create);
+        }
+        if (e != nullptr) {
+            fn(*e, unsigned((a % ViewPage) / SubPage), a);
+        }
+    }
+    if (e != nullptr) {
+        ApplyLocked(page, *e);
+    }
+}
+
 void FaultHandler(int signal, void* ucontext) {
     const auto* mcontext = static_cast<const unsigned char*>(ucontext) + McontextOffset;
     std::uintptr_t addr;
@@ -128,6 +298,13 @@ void FaultHandler(int signal, void* ucontext) {
     if (CommitAddress(addr)) {
         return; // the access runs again and now finds memory
     }
+    if (ViewFault(addr)) {
+        return; // first touch of a fastmem page: mapped now
+    }
+    if (const JitFaultHandler jit = g_jit.load(std::memory_order_acquire); jit && jit(ucontext)) {
+        g_jit_redirects.fetch_add(1, std::memory_order_relaxed);
+        return; // dynarmic sent the access down its slow path
+    }
     if (const FaultChain next = g_next.load(std::memory_order_acquire)) {
         next(signal, ucontext);
     }
@@ -299,6 +476,11 @@ void SetGuestRamBase(void* base, std::size_t size) {
 }
 
 void OnGuestRamFreed(std::size_t offset, std::size_t size) {
+    if (g_view_base != 0) {
+        // The view may map these chunks a second time; releasing them would leave it pointing at
+        // memory the system hands to someone else. The next owner clears them anyway.
+        return;
+    }
     unsigned char* const base = g_guest_base.load();
     if (base != nullptr && offset < g_guest_size.load()) {
         DecommitLazy(base + offset, size);
@@ -309,4 +491,199 @@ Stats GetStats() {
     return {g_reserved.load(), g_committed.load(), g_failures.load(), g_decommitted.load()};
 }
 
+// ---- fastmem -----------------------------------------------------------------------------------
+
+namespace {
+
+// The FakeCall check: a load from an unmapped page whose fault handler pushes a return address and
+// sends rip elsewhere, exactly what dynarmic does to resume a fastmem miss on its slow path.
+extern "C" std::uint64_t EdenPs4FakeCallProbe(const volatile std::uint64_t* p);
+extern "C" const char EdenPs4FakeCallProbeLoad[], EdenPs4FakeCallProbeResume[],
+    EdenPs4FakeCallProbeTarget[];
+asm(R"(
+    .text
+    .p2align 4
+    .globl EdenPs4FakeCallProbe
+EdenPs4FakeCallProbe:
+    xorl %eax, %eax
+    .globl EdenPs4FakeCallProbeLoad
+EdenPs4FakeCallProbeLoad:
+    movq (%rdi), %rax
+    .globl EdenPs4FakeCallProbeResume
+EdenPs4FakeCallProbeResume:
+    ret
+    .globl EdenPs4FakeCallProbeTarget
+EdenPs4FakeCallProbeTarget:
+    movl $0x5eed, %eax
+    ret
+)");
+
+constexpr std::size_t McRip = 160, McRsp = 184;
+
+bool ProbeHandler(void* ucontext) {
+    auto* mc = static_cast<unsigned char*>(ucontext) + McontextOffset;
+    std::uint64_t rip, rsp;
+    std::memcpy(&rip, mc + McRip, sizeof(rip));
+    if (rip != reinterpret_cast<std::uint64_t>(EdenPs4FakeCallProbeLoad)) {
+        return false;
+    }
+    std::memcpy(&rsp, mc + McRsp, sizeof(rsp));
+    rsp -= sizeof(std::uint64_t);
+    const auto resume = reinterpret_cast<std::uint64_t>(EdenPs4FakeCallProbeResume);
+    std::memcpy(reinterpret_cast<void*>(rsp), &resume, sizeof(resume));
+    const auto target = reinterpret_cast<std::uint64_t>(EdenPs4FakeCallProbeTarget);
+    std::memcpy(mc + McRsp, &rsp, sizeof(rsp));
+    std::memcpy(mc + McRip, &target, sizeof(target));
+    return true;
+}
+
+} // Anonymous namespace
+
+bool FastmemSelfTest(char* report, std::size_t report_size) {
+    auto fail = [&](const char* what, int rc) {
+        std::snprintf(report, report_size, "fastmem self-test FAILED at %s (0x%08x): fastmem off",
+                      what, static_cast<unsigned>(rc));
+        g_fastmem_ok.store(false);
+        return false;
+    };
+    // 1. One 64 KiB piece of direct memory mapped at two addresses: a write through one is seen
+    //    through the other, and the second mapping takes mprotect both ways.
+    off_t phys = 0;
+    const off_t total = static_cast<off_t>(sceKernelGetDirectMemorySize());
+    int rc = sceKernelAllocateDirectMemory(0, total, Chunk, Chunk, WbOnion, &phys);
+    if (rc != 0) {
+        return fail("allocate", rc);
+    }
+    void* a = nullptr;
+    void* b = nullptr;
+    rc = sceKernelMapDirectMemory(&a, Chunk, ProtReadWrite, 0, phys, ViewPage);
+    if (rc != 0) {
+        sceKernelReleaseDirectMemory(phys, Chunk);
+        return fail("first mapping", rc);
+    }
+    rc = sceKernelReserveVirtualRange(&b, 2 * Chunk, 0, Chunk);
+    if (rc != 0) {
+        sceKernelMunmap(a, Chunk);
+        sceKernelReleaseDirectMemory(phys, Chunk);
+        return fail("reserve", rc);
+    }
+    // The second mapping is one 16 KiB page from the middle, at a fixed spot in a reservation:
+    // the way the view maps pages.
+    void* page = static_cast<char*>(b) + Chunk;
+    rc = sceKernelMapDirectMemory(&page, ViewPage, ProtReadWrite, MapFixed, phys + 2 * ViewPage,
+                                  ViewPage);
+    bool alias_ok = false;
+    if (rc == 0) {
+        auto* pa = static_cast<volatile std::uint32_t*>(a);
+        auto* pb = static_cast<volatile std::uint32_t*>(page);
+        pa[2 * ViewPage / 4 + 3] = 0xC0FFEE01u;
+        const bool seen_b = pb[3] == 0xC0FFEE01u;
+        pb[5] = 0xC0FFEE02u;
+        const bool seen_a = pa[2 * ViewPage / 4 + 5] == 0xC0FFEE02u;
+        alias_ok = seen_a && seen_b && sceKernelMprotect(page, ViewPage, ProtRead) == 0 &&
+                   pb[3] == 0xC0FFEE01u &&
+                   sceKernelMprotect(page, ViewPage, ProtReadWrite) == 0;
+    }
+    sceKernelMunmap(a, Chunk);
+    // 2. The FakeCall: a load from the unmapped first half of the reservation.
+    std::uint64_t probe = 0;
+    if (rc == 0 && alias_ok) {
+        g_jit.store(ProbeHandler, std::memory_order_release);
+        probe = EdenPs4FakeCallProbe(static_cast<const volatile std::uint64_t*>(b));
+        g_jit.store(nullptr, std::memory_order_release);
+        g_jit_redirects.store(0);
+    }
+    sceKernelMunmap(b, 2 * Chunk);
+    sceKernelReleaseDirectMemory(phys, Chunk);
+    if (rc != 0) {
+        return fail("second mapping", rc);
+    }
+    if (!alias_ok) {
+        return fail("alias or mprotect", 0);
+    }
+    if (probe != 0x5eed) {
+        return fail("fault redirect", static_cast<int>(probe));
+    }
+    std::snprintf(report, report_size,
+                  "fastmem self-test ok: direct memory aliases, mprotect, fault redirect (rip/rsp)");
+    g_fastmem_ok.store(true);
+    return true;
+}
+
+bool FastmemAvailable() {
+    return g_fastmem_ok.load();
+}
+
+void* ReserveView(std::size_t size) {
+    if (!g_fastmem_ok.load() || g_view_base != 0) {
+        return nullptr;
+    }
+    constexpr std::size_t Span = std::size_t{1} << ViewSpanBits;
+    size = (size + Span - 1) & ~(Span - 1);
+    void* base = nullptr;
+    if (sceKernelReserveVirtualRange(&base, size, 0, std::size_t{1} << 21) != 0 || base == nullptr) {
+        return nullptr;
+    }
+    auto** tables = new (std::nothrow) std::uint64_t*[size >> ViewSpanBits]();
+    if (tables == nullptr) {
+        sceKernelMunmap(base, size);
+        return nullptr;
+    }
+    SpinGuard guard;
+    g_view_tables = tables;
+    g_view_size = size;
+    g_view_base = reinterpret_cast<std::uintptr_t>(base);
+    return base;
+}
+
+void ViewMap(std::size_t view_offset, std::size_t backing_offset, std::size_t size, bool read,
+             bool write) {
+    const bool congruent = (view_offset % ViewPage) == (backing_offset % ViewPage);
+    ForEachSubPage(view_offset, size, true, [&](std::uint64_t& e, unsigned sub, std::size_t a) {
+        const std::uint64_t bit = std::uint64_t{1} << sub;
+        if (!congruent) {
+            e &= ~(bit << ValidShift);
+            g_view_conflicts.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        const std::uint64_t backing_page = (backing_offset + (a - view_offset)) / ViewPage;
+        const unsigned valid = (e >> ValidShift) & 0xF;
+        if (valid != 0 && (e & 0xFFFFFFFFu) != backing_page) {
+            // Another backing page was here: the other pieces of it can no longer be reached
+            // through this page (they stay correct through the page table).
+            e &= ~(std::uint64_t{0xF} << ValidShift);
+            DropHostLocked(a / ViewPage, e);
+            g_view_conflicts.fetch_add(1, std::memory_order_relaxed);
+        }
+        e = (e & ~std::uint64_t{0xFFFFFFFFu}) | backing_page;
+        e |= bit << ValidShift;
+        e = read ? e | (bit << ReadShift) : e & ~(bit << ReadShift);
+        e = write ? e | (bit << WriteShift) : e & ~(bit << WriteShift);
+    });
+}
+
+void ViewUnmap(std::size_t view_offset, std::size_t size) {
+    ForEachSubPage(view_offset, size, false, [&](std::uint64_t& e, unsigned sub, std::size_t) {
+        e &= ~((std::uint64_t{1} << sub) << ValidShift);
+    });
+}
+
+void ViewProtect(std::size_t view_offset, std::size_t size, bool read, bool write) {
+    ForEachSubPage(view_offset, size, false, [&](std::uint64_t& e, unsigned sub, std::size_t) {
+        const std::uint64_t bit = std::uint64_t{1} << sub;
+        e = read ? e | (bit << ReadShift) : e & ~(bit << ReadShift);
+        e = write ? e | (bit << WriteShift) : e & ~(bit << WriteShift);
+    });
+}
+
+void SetJitFaultHandler(JitFaultHandler handler) {
+    g_jit.store(handler, std::memory_order_release);
+}
+
+ViewStats GetViewStats() {
+    return {g_view_mapped.load(), g_view_touches.load(), g_jit_redirects.load(),
+            g_view_conflicts.load()};
+}
+
+
 } // namespace Common::Orbis
