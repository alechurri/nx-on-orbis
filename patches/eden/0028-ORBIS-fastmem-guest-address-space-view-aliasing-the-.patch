+// ---- fastmem (test 25) --------------------------------------------------------------------------
+// The guest address space as one host range (HostMemory's virtual_base), so the JIT reaches guest
+// memory with one instruction instead of a page-table walk. Every 16 KiB host page of it aliases a
+// 16 KiB piece of the guest RAM backing (the same direct memory mapped twice), mapped on its first
+// touch. A page is mapped only when its four 4 KiB guest pages map consecutive backing with read
+// access; anything else stays unmapped and the JIT's access faults into dynarmic, which moves that
+// instruction to the page-table path. Correctness never depends on the view: the page table is
+// always authoritative.
+
+/// Runs the startup checks fastmem needs (direct memory mapped twice; a fault handler that moves
+/// rip/rsp, the way dynarmic resumes a faulting access). Writes a one-line report.
+bool FastmemSelfTest(char* report, std::size_t report_size);
+/// Self-test passed and fastmem was not switched off.
+bool FastmemAvailable();
+/// Reserves the view (HostMemory). Returns nullptr when fastmem is unavailable or it fails.
+void* ReserveView(std::size_t size);
+/// HostMemory::Map / Unmap / Protect on the view. Offsets are guest virtual addresses and offsets
+/// into the guest RAM backing.
+void ViewMap(std::size_t view_offset, std::size_t backing_offset, std::size_t size, bool read,
+             bool write);
+void ViewUnmap(std::size_t view_offset, std::size_t size);
+void ViewProtect(std::size_t view_offset, std::size_t size, bool read, bool write);
+
+/// dynarmic's handler for faults inside JIT code (fastmem misses): returns true when it redirected
+/// the thread (ucontext modified). Called after lazy commits and view first-touches.
+using JitFaultHandler = bool (*)(void* ucontext);
+void SetJitFaultHandler(JitFaultHandler handler);
+
+struct ViewStats {
+    std::size_t mapped_pages;   // 16 KiB view pages currently mapped
+    std::size_t first_touches;  // view faults that mapped a page
+    std::size_t jit_redirects;  // faults handed to dynarmic (instruction moved to the slow path)
+    std::size_t conflicts;      // view pages that could not alias (misaligned or mixed backing)
+};
+ViewStats GetViewStats();
+
 } // namespace Common::Orbis
