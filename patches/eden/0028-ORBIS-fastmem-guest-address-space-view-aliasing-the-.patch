@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// eden-ps4: fastmem fault handling on the PS4 (OpenOrbis).
+//
+// Faults there never reach sigaction; they come through the kernel exception handler that
+// common/orbis_lazy_memory installs, which commits lazy memory and maps first touches of the
+// fastmem view itself and hands the rest here. A fault inside a JIT code buffer at a fastmem patch
+// location is resumed the way the POSIX handler does it: push the resume address and call the
+// slow-path thunk (the startup self-test checked that this kernel honours a modified rip/rsp).
+
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cstring>
+#include <functional>
+#include <mutex>
+
+#include "common/orbis_lazy_memory.h"
+#include "dynarmic/backend/exception_handler.h"
+#include "dynarmic/backend/x64/block_of_code.h"
+
+namespace Dynarmic::Backend {
+
+namespace {
+
+// PS4 ucontext: 16-byte signal mask + 48 bytes of padding, then a FreeBSD amd64 mcontext.
+constexpr std::size_t McontextOffset = 64;
+constexpr std::size_t McRip = 160, McRsp = 184;
+
+struct CodeBlock {
+    std::atomic<u64> start{0};
+    std::atomic<u64> size{0};
+    std::function<FakeCall(u64)> cb;
+    std::atomic<bool> has_cb{false};
+};
+
+// One per JIT (each emulated core has its own); never more than a handful.
+constexpr std::size_t MaxBlocks = 32;
+std::array<CodeBlock, MaxBlocks> g_blocks;
+std::mutex g_register_mutex;
+
+bool OnFault(void* ucontext) {
+    auto* mc = static_cast<unsigned char*>(ucontext) + McontextOffset;
+    u64 rip;
+    std::memcpy(&rip, mc + McRip, sizeof(rip));
+    for (CodeBlock& block : g_blocks) {
+        const u64 start = block.start.load(std::memory_order_acquire);
+        const u64 size = block.size.load(std::memory_order_acquire);
+        if (size == 0 || rip < start || rip - start >= size) {
+            continue;
+        }
+        if (!block.has_cb.load(std::memory_order_acquire)) {
+            return false;
+        }
+        const FakeCall fc = block.cb(rip);
+        u64 rsp;
+        std::memcpy(&rsp, mc + McRsp, sizeof(rsp));
+        rsp -= sizeof(u64);
+        std::memcpy(std::bit_cast<void*>(rsp), &fc.ret_rip, sizeof(u64));
+        std::memcpy(mc + McRsp, &rsp, sizeof(rsp));
+        std::memcpy(mc + McRip, &fc.call_rip, sizeof(u64));
+        return true;
+    }
+    return false;
+}
+
+} // Anonymous namespace
+
+struct ExceptionHandler::Impl final {
+    explicit Impl(CodeBlock* block_) : block{block_} {}
+    ~Impl() {
+        std::scoped_lock lock{g_register_mutex};
+        block->has_cb.store(false, std::memory_order_release);
+        block->size.store(0, std::memory_order_release);
+        block->start.store(0, std::memory_order_release);
+    }
+    CodeBlock* block;
+};
+
+ExceptionHandler::ExceptionHandler() = default;
+ExceptionHandler::~ExceptionHandler() = default;
+
+void ExceptionHandler::Register(X64::BlockOfCode& code) {
+    if (!::Common::Orbis::FastmemAvailable()) {
+        return;
+    }
+    std::scoped_lock lock{g_register_mutex};
+    for (CodeBlock& block : g_blocks) {
+        if (block.size.load(std::memory_order_relaxed) == 0) {
+            block.has_cb.store(false, std::memory_order_relaxed);
+            block.start.store(std::bit_cast<u64>(code.getCode()), std::memory_order_release);
+            block.size.store(code.GetTotalCodeSize(), std::memory_order_release);
+            impl = std::make_unique<Impl>(&block);
+            ::Common::Orbis::SetJitFaultHandler(&OnFault);
+            return;
+        }
+    }
+}
+
+bool ExceptionHandler::SupportsFastmem() const noexcept {
+    return bool(impl) && ::Common::Orbis::FastmemAvailable();
+}
+
+void ExceptionHandler::SetFastmemCallback(std::function<FakeCall(u64)> cb) {
+    if (!impl) {
+        return;
+    }
+    std::scoped_lock lock{g_register_mutex};
+    impl->block->cb = std::move(cb);
+    impl->block->has_cb.store(true, std::memory_order_release);
+}
+
+} // namespace Dynarmic::Backend
