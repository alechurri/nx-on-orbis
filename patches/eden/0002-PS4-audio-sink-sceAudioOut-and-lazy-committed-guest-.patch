diff --git a/src/common/orbis_lazy_memory.cpp b/src/common/orbis_lazy_memory.cpp
new file mode 100644
index 0000000..2620d47
--- /dev/null
+++ b/src/common/orbis_lazy_memory.cpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PS4 (OpenOrbis): address ranges that get memory only where they are touched. See the header.
+//
+// Measured on the target console (eden-probe, PS4 Pro, FW 12.52): a range reserved with
+// sceKernelReserveVirtualRange takes MAP_FIXED direct-memory mappings inside it, and a fault
+// handler installed with sceKernelInstallExceptionHandler can return and have the faulting
+// access retried (about 5 us per fault).
+
+#include <atomic>
+#include <cstring>
+#include <new>
+
+#include <sys/types.h>
+
+#include "common/orbis_lazy_memory.h"
+
+extern "C" {
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t len,
+                                      size_t alignment, int32_t memory_type, off_t* phys_out);
+int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags,
+                                 off_t phys, size_t alignment);
+int32_t sceKernelReleaseDirectMemory(off_t phys, size_t len);
+int32_t sceKernelReserveVirtualRange(void** addr, size_t len, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void* addr, size_t len);
+size_t sceKernelGetDirectMemorySize(void);
+int sceKernelInstallExceptionHandler(int signal, void (*handler)(int, void*));
+}
+
+namespace Common::Orbis {
+
+namespace {
+
+constexpr std::size_t Chunk = 64 * 1024;
+constexpr int32_t ProtCpuRw = 0x03;
+constexpr int32_t MapFixed = 0x0010;
+constexpr int32_t WbOnion = 0;
+constexpr int SigBus = 10;  // FreeBSD numbering, as the exception API takes them
+constexpr int SigSegv = 11;
+// PS4 ucontext: 16-byte signal mask + 48 bytes of padding, then a FreeBSD amd64 mcontext.
+constexpr std::size_t McontextOffset = 64;
+constexpr std::size_t McAddr = 136;
+
+struct Region {
+    std::uintptr_t base;
+    std::size_t size;
+    std::atomic<off_t>* phys; // one per chunk; -1 = not committed
+    const char* name;
+};
+
+constexpr int MaxRegions = 64;
+Region g_regions[MaxRegions];
+std::atomic<int> g_region_count{0};
+std::atomic_flag g_lock = ATOMIC_FLAG_INIT;
+std::atomic<FaultChain> g_next{nullptr};
+std::atomic<std::size_t> g_reserved{0};
+std::atomic<std::size_t> g_committed{0};
+std::atomic<std::size_t> g_failures{0};
+
+struct SpinGuard {
+    SpinGuard() {
+        while (g_lock.test_and_set(std::memory_order_acquire)) {
+        }
+    }
+    ~SpinGuard() {
+        g_lock.clear(std::memory_order_release);
+    }
+};
+
+Region* FindRegion(std::uintptr_t addr) {
+    const int count = g_region_count.load(std::memory_order_acquire);
+    for (int i = 0; i < count; ++i) {
+        Region& r = g_regions[i];
+        if (r.size != 0 && addr >= r.base && addr - r.base < r.size) {
+            return &r;
+        }
+    }
+    return nullptr;
+}
+
+// Caller holds g_lock.
+bool CommitChunkLocked(Region& r, std::size_t index) {
+    if (r.phys[index].load(std::memory_order_relaxed) != -1) {
+        return true;
+    }
+    off_t phys = 0;
+    if (sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), Chunk,
+                                      Chunk, WbOnion, &phys) != 0) {
+        g_failures.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    void* at = reinterpret_cast<void*>(r.base + index * Chunk);
+    if (sceKernelMapDirectMemory(&at, Chunk, ProtCpuRw, MapFixed, phys, Chunk) != 0 ||
+        reinterpret_cast<std::uintptr_t>(at) != r.base + index * Chunk) {
+        sceKernelReleaseDirectMemory(phys, Chunk);
+        g_failures.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    // Direct memory comes back with whatever the last owner left in it.
+    std::memset(at, 0, Chunk);
+    r.phys[index].store(phys, std::memory_order_release);
+    g_committed.fetch_add(Chunk, std::memory_order_relaxed);
+    return true;
+}
+
+bool CommitAddress(std::uintptr_t addr) {
+    Region* r = FindRegion(addr);
+    if (r == nullptr) {
+        return false;
+    }
+    SpinGuard guard;
+    return CommitChunkLocked(*r, (addr - r->base) / Chunk);
+}
+
+void FaultHandler(int signal, void* ucontext) {
+    const auto* mcontext = static_cast<const unsigned char*>(ucontext) + McontextOffset;
+    std::uintptr_t addr;
+    std::memcpy(&addr, mcontext + McAddr, sizeof(addr));
+    if (CommitAddress(addr)) {
+        return; // the access runs again and now finds memory
+    }
+    if (const FaultChain next = g_next.load(std::memory_order_acquire)) {
+        next(signal, ucontext);
+    }
+}
+
+} // Anonymous namespace
+
+void InstallFaultHandler(FaultChain next) {
+    g_next.store(next, std::memory_order_release);
+    static const bool installed = [] {
+        sceKernelInstallExceptionHandler(SigSegv, FaultHandler);
+        sceKernelInstallExceptionHandler(SigBus, FaultHandler);
+        return true;
+    }();
+    (void)installed;
+}
+
+void* ReserveLazy(std::size_t size, const char* name) {
+    size = (size + Chunk - 1) & ~(Chunk - 1);
+    if (size == 0) {
+        return nullptr;
+    }
+    void* base = nullptr;
+    if (sceKernelReserveVirtualRange(&base, size, 0, Chunk) != 0 || base == nullptr) {
+        return nullptr;
+    }
+    const std::size_t chunks = size / Chunk;
+    auto* phys = new (std::nothrow) std::atomic<off_t>[chunks];
+    if (phys == nullptr) {
+        sceKernelMunmap(base, size);
+        return nullptr;
+    }
+    for (std::size_t i = 0; i < chunks; ++i) {
+        phys[i].store(-1, std::memory_order_relaxed);
+    }
+    SpinGuard guard;
+    // Reuse a released slot first, so ranges that come and go do not fill the table.
+    int count = g_region_count.load(std::memory_order_relaxed);
+    int slot = -1;
+    for (int i = 0; i < count; ++i) {
+        if (g_regions[i].size == 0) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0) {
+        if (count == MaxRegions) {
+            delete[] phys;
+            sceKernelMunmap(base, size);
+            return nullptr;
+        }
+        slot = count;
+    }
+    g_regions[slot].base = reinterpret_cast<std::uintptr_t>(base);
+    g_regions[slot].phys = phys;
+    g_regions[slot].name = name;
+    g_regions[slot].size = size;
+    if (slot == count) {
+        g_region_count.store(count + 1, std::memory_order_release);
+    }
+    g_reserved.fetch_add(size, std::memory_order_relaxed);
+    return base;
+}
+
+void ReleaseLazy(void* base) {
+    std::atomic<off_t>* phys = nullptr;
+    std::size_t size = 0;
+    {
+        SpinGuard guard;
+        Region* r = FindRegion(reinterpret_cast<std::uintptr_t>(base));
+        if (r == nullptr || r->base != reinterpret_cast<std::uintptr_t>(base)) {
+            return;
+        }
+        phys = r->phys;
+        size = r->size;
+        r->size = 0;
+        r->phys = nullptr;
+    }
+    sceKernelMunmap(base, size);
+    for (std::size_t i = 0; i < size / Chunk; ++i) {
+        const off_t p = phys[i].load(std::memory_order_relaxed);
+        if (p != -1) {
+            sceKernelReleaseDirectMemory(p, Chunk);
+            g_committed.fetch_sub(Chunk, std::memory_order_relaxed);
+        }
+    }
+    g_reserved.fetch_sub(size, std::memory_order_relaxed);
+    delete[] phys;
+}
+
+bool CommitLazy(void* addr, std::size_t size) {
+    const auto start = reinterpret_cast<std::uintptr_t>(addr);
+    Region* r = FindRegion(start);
+    if (r == nullptr || size == 0) {
+        return r != nullptr;
+    }
+    const std::size_t first = (start - r->base) / Chunk;
+    const std::size_t last = (start + size - 1 - r->base) / Chunk;
+    SpinGuard guard;
+    for (std::size_t i = first; i <= last && i < r->size / Chunk; ++i) {
+        if (!CommitChunkLocked(*r, i)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool IsCommitted(const void* addr) {
+    const auto a = reinterpret_cast<std::uintptr_t>(addr);
+    const Region* r = FindRegion(a);
+    if (r == nullptr) {
+        return true;
+    }
+    return r->phys[(a - r->base) / Chunk].load(std::memory_order_acquire) != -1;
+}
+
+void FillLazy(void* addr, std::size_t size, std::uint8_t value) {
+    auto* p = static_cast<unsigned char*>(addr);
+    if (value != 0 || FindRegion(reinterpret_cast<std::uintptr_t>(addr)) == nullptr) {
+        std::memset(p, value, size);
+        return;
+    }
+    while (size != 0) {
+        const auto a = reinterpret_cast<std::uintptr_t>(p);
+        const std::size_t in_chunk = Chunk - (a & (Chunk - 1));
+        const std::size_t n = in_chunk < size ? in_chunk : size;
+        if (IsCommitted(p)) {
+            std::memset(p, 0, n);
+        }
+        p += n;
+        size -= n;
+    }
+}
+
+Stats GetStats() {
+    return {g_reserved.load(), g_committed.load(), g_failures.load()};
+}
+
+} // namespace Common::Orbis
diff --git a/src/common/orbis_lazy_memory.h b/src/common/orbis_lazy_memory.h
new file mode 100644
index 0000000..9a49124
--- /dev/null
+++ b/src/common/orbis_lazy_memory.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PS4 (OpenOrbis): address ranges that get memory only where they are touched.
+//
+// The console gives a process ~4.4 GiB of direct memory, of which the GPU driver takes ~1 GiB,
+// and a Switch has 4 GiB of RAM plus the emulator's own tables (a 39-bit guest page table alone
+// is 1 GiB). Nothing that size can be allocated up front, and anonymous mappings come from a
+// ~400 MiB pool. So these ranges are only reserved; the first access to each 64 KiB chunk faults,
+// and the fault handler maps a zeroed chunk of direct memory there and lets the access retry.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace Common::Orbis {
+
+/// Called for faults that are not a first touch of a lazy range (a real crash).
+using FaultChain = void (*)(int signal, void* ucontext);
+
+/// Installs the lazy-commit fault handler (SIGSEGV and SIGBUS). Faults it does not own go to
+/// `next`. Safe to call more than once; the last `next` wins.
+void InstallFaultHandler(FaultChain next);
+
+/// Reserves `size` bytes of address space (rounded up to 64 KiB) that commit on first touch.
+/// Returns nullptr if the address space or the region table is exhausted.
+void* ReserveLazy(std::size_t size, const char* name);
+
+/// Unmaps a range from ReserveLazy and gives its committed memory back.
+void ReleaseLazy(void* base);
+
+/// Commits [addr, addr + size) now (no-op for parts already committed). False on failure or if
+/// the range is not lazy.
+bool CommitLazy(void* addr, std::size_t size);
+
+/// Whether the 64 KiB chunk holding `addr` has memory. Addresses outside lazy ranges: true.
+bool IsCommitted(const void* addr);
+
+/// Fills [addr, addr + size) with `value`; chunks that were never touched are skipped when the
+/// value is zero, because a chunk is zeroed when it is committed.
+void FillLazy(void* addr, std::size_t size, std::uint8_t value);
+
+struct Stats {
+    std::size_t reserved_bytes;
+    std::size_t committed_bytes;
+    std::size_t commit_failures;
+};
+Stats GetStats();
+
+} // namespace Common::Orbis
