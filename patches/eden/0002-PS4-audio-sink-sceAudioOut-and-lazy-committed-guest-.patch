new file mode 100644
index 0000000..818b408
--- /dev/null
+++ b/src/audio_core/sink/ps4_sink.cpp
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PS4 (OpenOrbis) audio output: sceAudioOut, one port per stream, fed by a thread.
+//
+// sceAudioOutOutput blocks until the port has room for the next grain, so the feeding thread is
+// paced by the hardware and needs no timer of its own. Input streams (microphone) produce nothing.
+
+#include <atomic>
+#include <span>
+#include <thread>
+#include <vector>
+
+#include "audio_core/common/common.h"
+#include "audio_core/sink/ps4_sink.h"
+#include "audio_core/sink/sink_stream.h"
+#include "common/logging.h"
+#include "common/thread.h"
+#include "core/core.h"
+
+extern "C" {
+int sceAudioOutInit(void);
+int sceAudioOutOpen(int user_id, int type, int index, unsigned int len, unsigned int freq,
+                    unsigned int param);
+int sceAudioOutOutput(int handle, const void* ptr);
+int sceAudioOutClose(int handle);
+}
+
+namespace AudioCore::Sink {
+
+namespace {
+constexpr int UserIdSystem = 0xFF;      // SCE_USER_SERVICE_USER_ID_SYSTEM
+constexpr int PortTypeMain = 0;         // SCE_AUDIO_OUT_PORT_TYPE_MAIN
+constexpr unsigned ParamS16Stereo = 1;  // SCE_AUDIO_OUT_PARAM_FORMAT_S16_STEREO
+constexpr unsigned GrainFrames = 256;   // frames handed to the port per call
+
+bool InitializeAudioOut() {
+    static const int result = sceAudioOutInit();
+    // 0x8026000E: already initialised (the frontend may have done it first)
+    return result == 0 || static_cast<unsigned>(result) == 0x8026000Eu;
+}
+} // Anonymous namespace
+
+class Ps4SinkStream final : public SinkStream {
+public:
+    Ps4SinkStream(u32 device_channels_, u32 system_channels_, StreamType type_,
+                  Core::System& system_)
+        : SinkStream{system_, type_} {
+        system_channels = system_channels_;
+        device_channels = device_channels_;
+        if (type == StreamType::In) {
+            return;
+        }
+        if (!InitializeAudioOut()) {
+            LOG_CRITICAL(Audio_Sink, "sceAudioOutInit failed");
+            return;
+        }
+        handle = sceAudioOutOpen(UserIdSystem, PortTypeMain, 0, GrainFrames, TargetSampleRate,
+                                 ParamS16Stereo);
+        if (handle < 0) {
+            LOG_CRITICAL(Audio_Sink, "sceAudioOutOpen failed: {:#x}", static_cast<u32>(handle));
+            return;
+        }
+        LOG_INFO(Audio_Sink, "PS4 audio port {} opened ({} Hz, {} frames, system channels {})",
+                 handle, TargetSampleRate, GrainFrames, system_channels);
+        feeder = std::jthread([this](std::stop_token stop) { Feed(stop); });
+    }
+
+    ~Ps4SinkStream() override {
+        Finalize();
+    }
+
+    void Finalize() override {
+        Stop();
+        if (feeder.joinable()) {
+            feeder.request_stop();
+            feeder.join();
+        }
+        if (handle >= 0) {
+            sceAudioOutClose(handle);
+            handle = -1;
+        }
+    }
+
+    void Start(bool resume = false) override {
+        if (handle < 0 || !paused) {
+            return;
+        }
+        paused = false;
+    }
+
+    void Stop() override {
+        if (handle < 0 || paused) {
+            return;
+        }
+        SignalPause();
+    }
+
+private:
+    void Feed(std::stop_token stop) {
+        Common::SetCurrentThreadName("AudioOutPS4");
+        std::vector<s16> grain(GrainFrames * 2);
+        std::vector<s16> silence(GrainFrames * 2);
+        while (!stop.stop_requested()) {
+            if (paused) {
+                sceAudioOutOutput(handle, silence.data());
+                continue;
+            }
+            ProcessAudioOutAndRender(std::span<s16>{grain}, GrainFrames);
+            sceAudioOutOutput(handle, grain.data());
+        }
+        sceAudioOutOutput(handle, nullptr); // wait for the last grain
+    }
+
+    int handle{-1};
+    std::jthread feeder;
+};
+
+Ps4Sink::Ps4Sink(std::string_view) {
+    device_channels = 2;
+}
+
+Ps4Sink::~Ps4Sink() = default;
+
+SinkStream* Ps4Sink::AcquireSinkStream(Core::System& system, u32 system_channels_,
+                                       const std::string&, StreamType type) {
+    system_channels = system_channels_;
+    SinkStreamPtr& stream = sink_streams.emplace_back(
+        std::make_unique<Ps4SinkStream>(device_channels, system_channels, type, system));
+    return stream.get();
+}
+
+void Ps4Sink::CloseStream(SinkStream* stream) {
+    for (size_t i = 0; i < sink_streams.size(); i++) {
+        if (sink_streams[i].get() == stream) {
+            sink_streams[i].reset();
+            sink_streams.erase(sink_streams.begin() + i);
+            break;
+        }
+    }
+}
+
+void Ps4Sink::CloseStreams() {
+    sink_streams.clear();
+}
+
+f32 Ps4Sink::GetDeviceVolume() const {
+    return sink_streams.empty() ? 1.0f : sink_streams[0]->GetDeviceVolume();
+}
+
+void Ps4Sink::SetDeviceVolume(f32 volume) {
+    for (auto& stream : sink_streams) {
+        stream->SetDeviceVolume(volume);
+    }
+}
+
+void Ps4Sink::SetSystemVolume(f32 volume) {
+    for (auto& stream : sink_streams) {
+        stream->SetSystemVolume(volume);
+    }
+}
+
+std::vector<std::string> ListPs4SinkDevices(bool capture) {
+    if (capture) {
+        return {};
+    }
+    return {"PS4 audio out"};
+}
+
+u32 GetPs4Latency() {
+    return GrainFrames * 2;
+}
+
+} // namespace AudioCore::Sink
